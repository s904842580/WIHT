# WAHT 编辑器基础规则，减少不同 IDE 保存后产生的无关格式变化。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{yml,yaml,json,ts,tsx,js,css,md,sql}]
indent_size = 2

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
