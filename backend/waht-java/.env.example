# WAHT 后端环境变量样例。
# Spring Boot 不会自动读取本文件，请在 IDEA Run Configuration、PowerShell 会话或系统环境变量中设置。

WAHT_SERVER_PORT=8080
WAHT_DB_URL=jdbc:mysql://localhost:3306/waht?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
WAHT_DB_USERNAME=root
WAHT_DB_PASSWORD=replace_with_local_password
WAHT_JWT_SECRET=replace_with_at_least_32_random_characters
WAHT_JWT_EXPIRATION_MINUTES=120
WAHT_AGENT_DELEGATION_EXPIRATION_MINUTES=2
WAHT_AGENT_BASE_URL=http://127.0.0.1:8000
WAHT_AGENT_SERVICE_TOKEN=replace_with_shared_agent_service_token
WAHT_AGENT_CONNECT_TIMEOUT_MILLIS=3000
WAHT_AGENT_READ_TIMEOUT_MILLIS=60000
WAHT_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
