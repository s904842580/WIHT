# WAHT Python Agent 服务环境变量样例。
WAHT_AGENT_HOST=127.0.0.1
WAHT_AGENT_PORT=8000
WAHT_AGENT_DB_URL=mysql+pymysql://root:replace_with_local_password@127.0.0.1:3306/waht_ai?charset=utf8mb4
WAHT_CORE_BASE_URL=http://127.0.0.1:8080
WAHT_AGENT_SERVICE_TOKEN=waht-local-agent-service-token-change-me
WAHT_AGENT_REQUEST_TIMEOUT_SECONDS=20
WAHT_AI_MODEL=replace_with_available_model
OPENAI_API_KEY=replace_with_openai_api_key
